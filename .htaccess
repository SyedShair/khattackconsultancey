<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to dotfiles like .env, .git, .htaccess itself
    RewriteRule ^\.(?!well-known) - [F,L]

    # If the request isn't already going to /public/, send it there
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Extra safety net in case mod_rewrite is ever disabled
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Prevent folder listing if someone browses to a directory with no index file
Options -Indexes